# Copy this file to .env and update the values as needed.
# Backend service settings
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb://localhost:27017/zyraviq_ai_logistics
AI_SERVICE_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=30
GOOGLE_MAPS_API_KEY=

# OTP / SMS login settings
# Set SMS_WEBHOOK_URL to your SMS provider endpoint. The backend sends:
# { to, otp, message, userId, companyId, companyName, provider }
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_STRICT_DELIVERY=false
LOGIN_OTP_TTL_MINUTES=5
LOGIN_OTP_RESEND_SECONDS=45

# AI service settings
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
